# 客户端构建变量（部署平台 Environment Variables 设置）
# 管理员登录密码变量（部署平台设置 PASSWORD 即可生效）
PASSWORD=123456

# 兼容与别名变量
EXPO_PUBLIC_PASSWORD=123456
EXPO_PUBLIC_ADMIN_PASSWORD=123456

# Expo 静态子路径（域名根目录部署留空；GitHub Pages 项目站点填写 /仓库名）
EXPO_BASE_URL=

# 可选独立后端 API 地址（纯静态或 Cloudflare Pages Functions 部署可留空）
EXPO_PUBLIC_API_BASE_URL=

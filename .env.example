# Browser-visible build variables. They are embedded in the web/native client bundle.
# Leave all values empty for the local demo-only blog.
EXPO_PUBLIC_API_BASE_URL=
MANUS_PROJECT_ID=
MANUS_OAUTH_PORTAL_URL=
MANUS_OAUTH_API_URL=
OWNER_OPEN_ID=
OWNER_NAME=

# Expo static subpath; leave empty for Cloudflare Pages, Netlify, Vercel and domain-root sites.
# GitHub Pages project sites use /<repository-name> (the workflow resolves this automatically).
EXPO_BASE_URL=

# Node API runtime only. Never rename secrets to EXPO_PUBLIC_*.
PORT=3000
DATABASE_URL=
MANUS_JWT_SECRET=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Exact comma-separated origins allowed to call the self-hosted API from browsers.
ALLOWED_WEB_ORIGINS=
